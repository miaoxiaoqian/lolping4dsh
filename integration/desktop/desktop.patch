--- /dev/null
+++ b/apps/desktop/src/quick-help.ts
@@ -0,0 +1,1235 @@
+/**
+ * The three capabilities a system-wide launcher needs and a Host plugin cannot
+ * provide: a floating window, a global-keyboard probe, and a managed native input
+ * helper.
+ *
+ * DSH plugins run in the Host process, which has no `BrowserWindow` and no
+ * shortcut registry. Both belong to the Electron main process, so they live here —
+ * and nothing else does. There is no wheel geometry, no action list, no model call,
+ * and no plugin state in this file. The plugin owns all of that; this layer only
+ * moves a window, reports input, and keeps a child process alive.
+ *
+ * The hotkey is deliberately *not* registered. A held `globalShortcut` is removed
+ * from every other application, which is the opposite of what this feature wants;
+ * the input helper observes key events instead and swallows only the exact chord.
+ * The only thing asked of the shortcut registry is whether a combination is already
+ * taken, and the answer is read and released in the same call.
+ *
+ * The overlay's documents are the plugin's own, served over the Host's HTTP
+ * surface through `dsh-app://app`. Loading them from the application bundle
+ * instead would mean this file also had to proxy the ask window's streaming
+ * answers, which is exactly the kind of business logic that does not belong on
+ * the Electron side of the fence.
+ *
+ * Four properties this file is responsible for:
+ *
+ *  - The overlay cannot navigate anywhere. It loads one plugin route per view,
+ *    and `will-navigate` cancels anything else, so a plugin cannot turn this
+ *    window into a general-purpose view of the app's own scheme.
+ *  - Only the overlay may drive these channels. The sender check requires the
+ *    exact window this class created, not merely a document from the same
+ *    origin — the main window is on that origin too.
+ *  - Teardown is total. Disposing removes the event tap by shutting the helper
+ *    down, destroys the window, and drops every listener. An event tap left
+ *    installed would swallow the user's keystrokes with nobody listening, which is
+ *    the one failure this feature must never cause.
+ *  - A helper that will not start is reported, not retried forever. Permission
+ *    failures in particular are not crashes, and looping on them would look like
+ *    a broken machine.
+ */
+
+import { BrowserWindow, globalShortcut, ipcMain, screen, systemPreferences } from 'electron'
+import { spawn } from 'node:child_process'
+import type { ChildProcess } from 'node:child_process'
+import { existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import type { IpcMainInvokeEvent } from 'electron'
+import type {
+  QuickHelpBindResult,
+  QuickHelpEnvironment,
+  QuickHelpFeedbackRequest,
+  QuickHelpHelperConfig,
+  QuickHelpInputEvent,
+  QuickHelpRoute,
+  QuickHelpWindowRequest,
+} from './quick-help-ipc.ts'
+import { QUICK_HELP_IPC, QUICK_HELP_ORIGIN, QUICK_HELP_ROUTE_PATH } from './quick-help-ipc.ts'
+import { forwardWebRequest } from './web-document.ts'
+import { askBesideFeedback, feedbackBounds, clampAskBounds, readAskPosition, writeAskPosition } from './quick-help-position.ts'
+import type { AskPosition, WorkArea } from './quick-help-position.ts'
+
+/** Why the helper is not running. */
+type HelperStatus = QuickHelpEnvironment['helper']
+
+/** Construction parameters. */
+export interface QuickHelpDesktopOptions {
+  /** Absolute path of the compiled input helper. */
+  readonly helperPath: string
+  /** How long the helper may be down before restarts stop. */
+  readonly restartBudget?: number
+  /** Notified when the helper's status changes, so the plugin can persist it. */
+  readonly onStatus?: (status: HelperStatus, detail?: string) => void
+  /** Brings the main application window forward. */
+  readonly focusMainWindow?: () => void
+  /**
+   * Absolute path of the preload that installs the overlay's bridge.
+   *
+   * Required rather than optional: without it the overlay's document runs with no
+   * bridge at all, every wheel gesture would arrive at a page that cannot hear it,
+   * and the failure would look like a dead hotkey rather than a missing file.
+   */
+  readonly preloadPath: string
+  /** Use the complete application conversation in the compact window. */
+  readonly compactChat?: boolean
+  /**
+   * The Host's URL and cookie, or undefined until the backend is ready.
+   *
+   * Read on each attempt rather than captured, because the desktop layer installs
+   * this feature at startup and the Host comes up afterwards.
+   */
+  readonly hostEndpoint?: () => { readonly host: string; readonly cookie: string } | undefined
+  /** Electron userData file containing only the chat window's last dragged coordinates. */
+  readonly askPositionPath?: string
+  /**
+   * How many times to retry before giving up on reaching the Host.
+   *
+   * Bounded on purpose: a plugin that never serves the route must not leave a timer
+   * running for the life of the process.
+   */
+  readonly hostSyncAttempts?: number
+}
+
+/** The main-process surface the overlay preload drives. */
+export class QuickHelpDesktop {
+  private helper: ChildProcess | undefined
+  private status: HelperStatus = 'stopped'
+  private overlay: BrowserWindow | undefined
+  private feedbackOverlay: BrowserWindow | undefined
+  private feedbackTimer: NodeJS.Timeout | undefined
+  private feedbackGeneration = 0
+  private feedbackStartedGeneration = 0
+  private readonly feedbackIds = new Set<string>()
+  private pendingCapture: Buffer | undefined
+  private capturing = false
+  private captureChild: ChildProcess | undefined
+  private captureOwner: string | undefined
+  private dragOrigin: { cursor: { x: number; y: number }; bounds: WorkArea } | undefined
+  private compactSessionId: string | undefined
+  private showGeneration = 0
+  private pendingCompactFeedback: QuickHelpFeedbackRequest | undefined
+  private overlayRoute: string | undefined
+  private overlayState: string | undefined
+  private overlayReady = false
+  private overlayLoading = false
+  private restarts = 0
+  private restartWindowStart = 0
+  private disposed = false
+  private readonly restartBudget: number
+  private readonly helperBuffer = { text: '' }
+  private testWheelTimer: NodeJS.Timeout | undefined
+  private testWheelAutoHideMs: number | undefined
+  private wheelOpenAck: { resolve: () => void; reject: (error: Error) => void; timer: NodeJS.Timeout } | undefined
+  private overlayReadyAttempts = 0
+  /**
+   * Events that arrived before the overlay finished loading.
+   *
+   * The very first wheel opening races the page load, and dropping that first
+   * event would mean the feature appeared broken on first use and worked on
+   * every use after it.
+   */
+  private pending: QuickHelpInputEvent[] = []
+  private statusWhileLoading: HelperStatus | undefined
+  /** Timer for the bounded retry that reaches the Host for its trigger config. */
+  private hostSyncTimer: NodeJS.Timeout | undefined
+  private hostSyncAttemptsLeft = 0
+  /** Whether the helper already has a chord, so retries stop once it does. */
+  private helperConfigured = false
+  private lastConfig = ''
+  private lastHelperConfig: QuickHelpHelperConfig | undefined
+  private overlayReadyTimer: NodeJS.Timeout | undefined
+  private askPosition: AskPosition | undefined
+  private programmedBounds: WorkArea | undefined
+  private positionWriteTimer: NodeJS.Timeout | undefined
+  private retryingHelper: ChildProcess | undefined
+  private helperReadyTimer: NodeJS.Timeout | undefined
+  private timedOutHelper: ChildProcess | undefined
+
+  /** @param options - Paths and lifecycle hooks. */
+  constructor(private readonly options: QuickHelpDesktopOptions) {
+    this.restartBudget = options.restartBudget ?? 3
+    this.hostSyncAttemptsLeft = options.hostSyncAttempts ?? 30
+    if (options.askPositionPath !== undefined) this.askPosition = readAskPosition(options.askPositionPath)
+  }
+
+  /**
+   * Ask the plugin what the helper should watch, and tell it.
+   *
+   * The trigger chord lives in the plugin's settings, and the only channel from
+   * the Host to the main process is HTTP — so the main process asks. Without this
+   * the helper is never configured until the user opens the settings page, and a
+   * first run with a silent feature is indistinguishable from a broken one.
+   *
+   * Retries because the Host is not up when this is installed; bounded because a
+   * plugin that never serves the route must not leave a timer for the life of the
+   * process.
+   */
+  async syncHelperConfig(): Promise<void> {
+    if (this.disposed || !this.supported) return
+    const endpoint = this.options.hostEndpoint?.()
+    if (endpoint === undefined) {
+      this.scheduleHostSync()
+      return
+    }
+    try {
+      const request = new Request(`${QUICK_HELP_ORIGIN}/quick-help/api/helper-config`, {
+        headers: { origin: QUICK_HELP_ORIGIN },
+      })
+      const response = await forwardWebRequest(request, endpoint.host, endpoint.cookie)
+      if (!response.ok) {
+        // The Host answers before the plugin's routes are mounted, which is normal
+        // on a cold start and is exactly what the retry is for.
+        this.scheduleHostSync()
+        return
+      }
+      const body = await response.json() as Partial<QuickHelpHelperConfig>
+      const config: QuickHelpHelperConfig = {
+        triggerVk: Number(body.triggerVk ?? 0),
+        modifierMask: Number(body.modifierMask ?? 0),
+        holdMode: body.holdMode === 1 ? 1 : 0,
+        dragThreshold: Number(body.dragThreshold ?? 12),
+        watchdogMs: Number(body.watchdogMs ?? 12_000),
+        enabled: body.enabled === 1 ? 1 : 0,
+      }
+      const serialized = JSON.stringify(config)
+      if (serialized !== this.lastConfig) {
+        this.configure(config)
+        this.lastConfig = serialized
+      }
+      this.helperConfigured = true
+      this.scheduleHostSync()
+    } catch (error) {
+      this.options.onStatus?.('stopped', error instanceof Error ? error.message : String(error))
+      this.scheduleHostSync()
+    }
+  }
+
+  /** Retry `syncHelperConfig` later, unless the budget or the helper is settled. */
+  private scheduleHostSync(): void {
+    if (this.disposed) return
+    if (!this.helperConfigured && this.hostSyncAttemptsLeft <= 0) return
+    if (this.hostSyncTimer !== undefined) return
+    if (!this.helperConfigured) this.hostSyncAttemptsLeft -= 1
+    this.hostSyncTimer = setTimeout(() => {
+      this.hostSyncTimer = undefined
+      void this.syncHelperConfig()
+    }, 2_000)
+    // Deliberately not `unref`ed: the point is to keep trying while the app is up.
+  }
+
+  /** Whether this machine can run the wheel at all. */
+  get supported(): boolean {
+    // Only macOS is implemented. The interface exists on every platform so a
+    // plugin can ask, and the honest answer here is "no" rather than a hotkey
+    // that registers and does nothing.
+    return process.platform === 'darwin'
+  }
+
+  /** Current helper status. */
+  get helperStatus(): HelperStatus {
+    return this.status
+  }
+
+  /** Open the wheel on demand from the product panel. */
+  openWheel(): Promise<void> {
+    if (!this.supported) return Promise.reject(new Error('全局轮盘仅支持 macOS'))
+    const point = screen.getCursorScreenPoint()
+    return new Promise((resolve, reject) => {
+      if (this.wheelOpenAck !== undefined) {
+        clearTimeout(this.wheelOpenAck.timer)
