+  }
+
+  /** Release buffered input only after the wheel renderer has subscribed. */
+  private markRendererReady(): void {
+    if (this.overlayRoute === QUICK_HELP_ROUTE_PATH.ask && this.options.compactChat) {
+      this.overlayReady = true
+      const feedback = this.pendingCompactFeedback
+      this.pendingCompactFeedback = undefined
+      if (feedback) this.showFeedback(feedback)
