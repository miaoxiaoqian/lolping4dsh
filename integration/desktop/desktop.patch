+    child.stdout?.setEncoding('utf8')
+    child.stdout?.on('data', (chunk: string) => {
+      if (this.helper === child && this.retryingHelper !== child && this.timedOutHelper !== child) this.consume(chunk)
+    })
+    child.stderr?.setEncoding('utf8')
+    child.stderr?.on('data', (chunk: string) => {
+      if (this.helper === child && this.retryingHelper !== child && this.timedOutHelper !== child) {
+        this.options.onStatus?.('crashed', chunk.trim().slice(0, 400))
+      }
+    })
+    child.on('error', (error) => {
+      if (this.helper !== child) return
+      if (this.helperReadyTimer !== undefined) clearTimeout(this.helperReadyTimer)
+      this.helper = undefined
+      if (this.retryingHelper === child) {
+        this.retryingHelper = undefined
+        if (!this.disposed) { this.start(); void this.syncHelperConfig() }
+        return
+      }
+      this.setStatus('crashed', error.message)
+    })
+    child.on('exit', (code, signal) => {
+      if (this.helper !== child) return
+      if (this.helperReadyTimer !== undefined) clearTimeout(this.helperReadyTimer)
+      this.helper = undefined
+      if (this.retryingHelper === child) {
+        this.retryingHelper = undefined
+        if (!this.disposed) {
+          this.start()
+          void this.syncHelperConfig()
+        }
+        return
+      }
+      if (this.timedOutHelper === child) {
+        this.timedOutHelper = undefined
+        return
+      }
+      if (this.disposed) {
+        this.setStatus('stopped')
+        return
+      }
