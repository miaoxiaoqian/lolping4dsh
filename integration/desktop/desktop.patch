diff --git a/apps/desktop/tests/preload.e2e.ts b/apps/desktop/tests/preload.e2e.ts
--- a/apps/desktop/tests/preload.e2e.ts
+++ b/apps/desktop/tests/preload.e2e.ts
@@ -89,4 +89,83 @@
       expect(invoke).toHaveBeenCalledWith('dsh-welcome:take-notice')
     }
   })
+
+  // The quick-help preload is the one that installs at module scope, because a
+  // sandboxed preload is evaluated by Electron rather than imported by anything.
+  // An exported-but-uncalled installer therefore type-checks, bundles, and reaches
+  // production while exposing nothing — and the overlay's symptom would be a wheel
+  // that never opens and a settings page that never saves, with nothing in the log
+  // pointing at a preload that ran and did nothing.
+  describe('quick-help bridge', () => {
+    /** Execute the built preload as Electron would, at one page URL. */
+    function runAt(href: string): { exposed: Map<string, Record<string, unknown>>; invoke: ReturnType<typeof vi.fn> } {
+      const exposed = new Map<string, Record<string, unknown>>()
+      const invoke = vi.fn<(...args: unknown[]) => Promise<unknown>>(() => Promise.resolve({ supported: true, helper: 'running', displays: [] }))
+      const electron = {
+        contextBridge: { exposeInMainWorld: (key: string, value: Record<string, unknown>) => { exposed.set(key, value) } },
+        ipcRenderer: { invoke, send: vi.fn(), on: vi.fn(), off: vi.fn(), removeListener: vi.fn() },
+      }
+      runInNewContext(readFileSync(preload('preload-quick-help'), 'utf8'), {
+        require: (id: string) => {
+          if (id !== 'electron') throw new Error(`sandbox cannot load ${id}`)
+          return electron
+        },
+        ...browserEnvironment().globals,
+        process: { argv: ['electron'], isMainFrame: true, platform: 'darwin' },
+        location: new URL(href),
+        // Browser globals the preload uses to validate its own page and read `state`.
+        URL,
+        URLSearchParams,
+        exports: {},
+      })
+      return { exposed, invoke }
+    }
+
+    it.each(['wheel', 'ask', 'settings', 'feedback'] as const)('exposes the bridge on /quick-help/%s with or without state', (route) => {
+      const { exposed } = runAt(`dsh-app://app/quick-help/${route}`)
+      expect(exposed.has('__DSH_QUICK_HELP__')).toBe(true)
+      const withState = runAt(`dsh-app://app/quick-help/${route}?state=task-1`)
+      expect(withState.exposed.has('__DSH_QUICK_HELP__')).toBe(true)
+    })
+
+    it('carries the state string the host put in the URL', () => {
+      const { exposed } = runAt('dsh-app://app/quick-help/ask?state=harness-guard%2Fv3')
+      const bridge = exposed.get('__DSH_QUICK_HELP__') as { initialState(): string | undefined }
+      expect(bridge.initialState()).toBe('harness-guard/v3')
+    })
+
+    it('routes every bridge call to its own channel', () => {
+      const { exposed, invoke } = runAt('dsh-app://app/quick-help/wheel')
+      const bridge = exposed.get('__DSH_QUICK_HELP__') as {
+        probeHotkey(accelerator: string): unknown
+        hide(route?: 'wheel' | 'ask' | 'settings'): unknown
+        feedbackReady(generation: number): unknown
+      }
+      bridge.probeHotkey('Control+Option+Space')
+      expect(invoke).toHaveBeenCalledWith('dsh-quick-help:probe-hotkey', 'Control+Option+Space')
+      bridge.feedbackReady(7)
+      expect(invoke).toHaveBeenCalledWith('dsh-quick-help:feedback-ready', 7)
+      bridge.hide('wheel')
+      expect(invoke).toHaveBeenCalledWith('dsh-quick-help:hide', 'wheel')
+    })
+
+    // The main window is on the same origin and is not owned by this feature, so a
+    // bridge that can move a window and drive a global input tap must not be
+    // reachable from an ordinary document.
+    it.each([
+      'dsh-app://app/',
+      'dsh-app://shell/settings.html',
+      // A prefix match would let a path that merely starts the same way through.
+      'dsh-app://app/quick-help/wheelish',
+      'dsh-app://app/quick-help/',
+      // The one that a `href.slice(13).split('?')[1]` guard lets through: the
+      // pathname is someone else's document and the route only appears in the
+      // query string, so a bridge installed here would be handed a page the
+      // sender check never approved.
+      'dsh-app://app/other?/quick-help/wheel',
+    ])('withholds the bridge from %s', (href) => {
+      const { exposed } = runAt(href)
+      expect(exposed.has('__DSH_QUICK_HELP__')).toBe(false)
+    })
+  })
 })
