+      if (opening !== undefined && this.pending.length < 8) this.pending.push(opening)
+      this.overlayRoute = undefined
+      return
+    }
+    if (this.overlayLoading && this.overlayRoute === path) {
+      if (opening !== undefined && this.pending.length < 8) this.pending.push(opening)
+      return
+    }
+    if (this.overlayRoute !== path || this.overlayState !== undefined || !this.overlayReady) {
+      this.overlayRoute = path
+      this.overlayState = undefined
+      this.overlayReady = false
+      this.overlayLoading = true
+      this.pending.length = 0
+      if (opening !== undefined) this.pending.push(opening)
+      void window.loadURL(`${QUICK_HELP_ORIGIN}${path}`).catch((error: unknown) => {
+        this.overlayLoading = false
+        this.overlayRoute = undefined
+        this.options.onStatus?.('crashed', error instanceof Error ? error.message : String(error))
+        this.rejectWheelOpen(error instanceof Error ? error : new Error(String(error)))
+      })
