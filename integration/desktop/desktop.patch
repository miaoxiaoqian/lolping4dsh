+import { expect, it } from 'vitest'
+import { askBesideFeedback, feedbackBounds } from '../src/quick-help-position.ts'
+
+it('keeps the selection point unchanged on a display with a negative origin', () => {
+  const area = { x: -1440, y: -900, width: 1440, height: 900 }
+  const point = { x: -700, y: -500, kind: 'emote' as const }
+  expect(feedbackBounds(point, area)).toEqual({ x: -780, y: -580, width: 160, height: 160 })
+  const chat = askBesideFeedback(point, area)
+  expect(chat.x - (point.x + 65)).toBe(12)
+  expect(chat.y).toBe(-536)
+})
+
+it('flips the chat left at the right edge and clamps feedback only enough to stay visible', () => {
+  const area = { x: 0, y: 0, width: 1440, height: 900 }
+  const point = { x: 1435, y: 450, kind: 'ping' as const }
+  const effect = feedbackBounds(point, area)
+  const chat = askBesideFeedback(point, area)
+  expect(effect).toEqual({ x: 1280, y: 370, width: 160, height: 160 })
+  expect((effect.x + 80 - 52) - (chat.x + chat.width)).toBe(12)
+})
