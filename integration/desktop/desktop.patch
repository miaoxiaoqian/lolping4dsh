+    if (window === undefined || window.isDestroyed()) throw new Error('quick help: no overlay window')
+    if (event.sender !== window.webContents || event.senderFrame !== window.webContents.mainFrame) {
+      throw new Error('quick help: rejected unowned renderer')
+    }
+  }
+
+  /** Spawn the helper, unless it is already running. */
+  private start(): void {
+    if (this.helper !== undefined || this.disposed) return
+    if (!this.supported) {
+      this.setStatus('unsupported')
+      return
+    }
+    this.setStatus('starting')
+    let child: ChildProcess
+    try {
+      child = spawn(this.options.helperPath, [], { stdio: ['pipe', 'pipe', 'pipe'] })
+    } catch (error) {
+      this.setStatus('crashed', error instanceof Error ? error.message : String(error))
+      return
+    }
+    this.helper = child
+    if (this.helperReadyTimer !== undefined) clearTimeout(this.helperReadyTimer)
+    this.helperReadyTimer = setTimeout(() => {
+      if (this.helper !== child || this.status === 'running' || this.status === 'no-access') return
+      this.timedOutHelper = child
+      this.setStatus('crashed', '输入助手未在 5 秒内报告事件监听就绪；请检查设备控制权限后重试。')
+      try { child.stdin?.end('{"type":"shutdown"}\n') } catch { child.kill('SIGTERM') }
+      const escalate = setTimeout(() => { if (this.helper === child) child.kill('SIGKILL') }, 1500)
+      child.once('exit', () => clearTimeout(escalate))
+    }, 5_000)
