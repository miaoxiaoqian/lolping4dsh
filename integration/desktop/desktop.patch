+/** Compact presentation is available only through the dedicated desktop preload. */
+export function isCompactConversation(): boolean {
+  const bridge = (globalThis as { __DSH_QUICK_HELP__?: { compactSessionId?(): string | undefined } }).__DSH_QUICK_HELP__
+  return !!bridge?.compactSessionId?.()
+}
