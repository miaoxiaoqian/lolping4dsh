new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/preload-quick-help.ts
@@ -0,0 +1,126 @@
+/**
+ * The only bridge the quick-help overlay gets.
+ *
+ * Deliberately narrow: it can move this feature's own window, change its
+ * hotkey, ask what the machine looks like, and read input events. It cannot
+ * navigate, evaluate, read a file, or reach any other part of the application.
+ * The overlay renders a wheel and an answer box; it has no business doing more,
+ * and a wider surface here would mean a wider surface to audit every time this
+ * feature changes.
+ *
+ * Everything else the page needs comes from its own plugin over HTTP, on the
+ * same origin, so this bridge never has to carry application data.
+ *
+ * Exposed on the overlay window only. The main application document and ordinary
+ * plugin pages never see it, so a plugin cannot reach the wheel's privileges from
+ * the sidebar.
+ */
+
+import { contextBridge, ipcRenderer } from 'electron'
+import './preload-app.ts'
+import type {
+  QuickHelpBindResult,
+  QuickHelpBridge,
+  QuickHelpEnvironment,
+  QuickHelpFeedbackRequest,
+  QuickHelpHelperConfig,
+  QuickHelpInputEvent,
+  QuickHelpRoute,
+  QuickHelpWindowRequest,
+} from './quick-help-ipc.ts'
+import { QUICK_HELP_IPC, QUICK_HELP_ORIGIN, QUICK_HELP_ROUTE_PATH } from './quick-help-ipc.ts'
+
+/**
+ * Install the bridge into the overlay window's isolated world.
+ *
+ * @param readState - The state string carried in the page URL, read once on load.
+ */
+export function installQuickHelpBridge(readState: () => string | undefined): void {
+  // Typed up front so a change to the contract fails here rather than silently
+  // widening what the page can reach.
+  const bridge: QuickHelpBridge & { initialState(): string | undefined } = {
+    compactSessionId: () => ownUrl.pathname === '/' ? ownUrl.searchParams.get('dshQuickHelpSession') ?? undefined : undefined,
+    /** The state the host put in the URL, so the page knows what to render. */
+    initialState: () => readState(),
+
+    environment: () => ipcRenderer.invoke(QUICK_HELP_IPC.environment) as Promise<QuickHelpEnvironment>,
+
+    show: (request: QuickHelpWindowRequest) => ipcRenderer.invoke(QUICK_HELP_IPC.show, request) as Promise<void>,
+
+    feedback: (request: QuickHelpFeedbackRequest) => ipcRenderer.invoke(QUICK_HELP_IPC.feedback, request) as Promise<void>,
+    feedbackReady: (generation: number) => ipcRenderer.invoke(QUICK_HELP_IPC.feedbackReady, generation) as Promise<void>,
+    onFeedbackShown: (listener: (generation: number) => void) => {
+      const wrapped = (_event: unknown, generation: number): void => { listener(generation) }
+      ipcRenderer.on(QUICK_HELP_IPC.feedbackShown, wrapped)
+      return () => { ipcRenderer.removeListener(QUICK_HELP_IPC.feedbackShown, wrapped) }
+    },
+    captureSelection: (owner: string) => ipcRenderer.invoke(QUICK_HELP_IPC.captureSelection, owner) as Promise<'captured' | 'cancelled'>,
+    readCapture: (owner: string) => ipcRenderer.invoke(QUICK_HELP_IPC.readCapture, owner) as Promise<string | undefined>,
+    stageCapture: (owner: string, dataUrl: string) => ipcRenderer.invoke(QUICK_HELP_IPC.stageCapture, owner, dataUrl) as Promise<void>,
+    discardCapture: () => ipcRenderer.invoke(QUICK_HELP_IPC.discardCapture) as Promise<void>,
+    dragWindow: (phase: 'start' | 'move' | 'end') => ipcRenderer.invoke(QUICK_HELP_IPC.dragWindow, phase) as Promise<void>,
+
+    hide: (route?: QuickHelpRoute) => ipcRenderer.invoke(QUICK_HELP_IPC.hide, route) as Promise<void>,
+
+    focusMain: () => ipcRenderer.invoke(QUICK_HELP_IPC.focusMain) as Promise<void>,
+
+    probeHotkey: (accelerator: string) => ipcRenderer.invoke(QUICK_HELP_IPC.probeHotkey, accelerator) as Promise<QuickHelpBindResult>,
+
+    configure: (config: QuickHelpHelperConfig) => ipcRenderer.invoke(QUICK_HELP_IPC.configure, config) as Promise<void>,
+
+    suspend: () => ipcRenderer.invoke(QUICK_HELP_IPC.suspend) as Promise<void>,
+
+    rendererReady: () => ipcRenderer.invoke(QUICK_HELP_IPC.rendererReady) as Promise<void>,
+
+    /**
+     * Subscribe to input events.
+     *
+     * The raw IpcRendererEvent is dropped rather than forwarded: handing a page
+     * the sender would give it a way to reply on this channel itself.
+     */
+    onInput: (listener: (event: QuickHelpInputEvent) => void) => {
+      const wrapped = (_event: unknown, payload: QuickHelpInputEvent): void => { listener(payload) }
+      ipcRenderer.on(QUICK_HELP_IPC.inputEvent, wrapped)
+      return () => { ipcRenderer.removeListener(QUICK_HELP_IPC.inputEvent, wrapped) }
+    },
+
+    onHelperStatus: (listener: (status: QuickHelpEnvironment['helper']) => void) => {
+      const wrapped = (_event: unknown, status: QuickHelpEnvironment['helper']): void => { listener(status) }
+      ipcRenderer.on(QUICK_HELP_IPC.helperStatus, wrapped)
+      return () => { ipcRenderer.removeListener(QUICK_HELP_IPC.helperStatus, wrapped) }
+    },
+  }
+  contextBridge.exposeInMainWorld('__DSH_QUICK_HELP__', bridge)
+}
+
+/**
+ * Install on load, for this feature's own pages only.
+ *
+ * This runs at module scope on purpose. A sandboxed Electron preload is not
+ * imported by anything — Electron evaluates the file as the preload script for the
+ * window it was configured on — so an exported installer that nothing calls is
+ * dead code that looks alive. The overlay would then load with no `DSH` object at
+ * all, every gesture would throw on the first property access, and the symptom
+ * would be a wheel that never appears and a settings page that never saves, with
+ * nothing in the log to connect either to a preload that ran but did nothing.
+ *
+ * The guard checks `protocol`, `host` and `pathname` separately, because the main
+ * window shares this origin and a bridge that can move a window and drive a global
+ * input tap must not be reachable from an ordinary document.
+ *
+ * It must be the parsed pathname and not a slice of the whole URL. Splitting the
+ * href on `?` and taking the second field reads the *query string* — which on a
+ * URL with no query is `undefined`, and on a crafted one is attacker-chosen text:
+ * `dsh-app://app/other?/quick-help/wheel` would satisfy a route check while
+ * loading someone else's document. `location.pathname` has no such reading, and
+ * the route list is compared whole, so `/quick-help/wheelish` cannot match either.
+ *
+ * `state` is read from `location.search` rather than re-parsing the href, so the
+ * query string that carries it stays out of the path decision entirely.
+ */
+const ownRoutes: readonly string[] = Object.values(QUICK_HELP_ROUTE_PATH)
+const ownUrl = new URL(location.href)
+if (`${ownUrl.protocol}//${ownUrl.host}` === QUICK_HELP_ORIGIN && (ownRoutes.includes(ownUrl.pathname) || ownUrl.pathname === '/quick-help/feedback'
+  || (ownUrl.pathname === '/' && ownUrl.searchParams.has('dshQuickHelpSession')))) {
+  installQuickHelpBridge(() => new URLSearchParams(ownUrl.search).get('state') ?? undefined)
+}
