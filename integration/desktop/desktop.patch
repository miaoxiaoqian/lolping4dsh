+      this.emitInput(opening)
+    }
+  }
+
+  /** Reject and clear the current panel request when its renderer cannot show. */
+  private rejectWheelOpen(error: Error): void {
+    const pending = this.wheelOpenAck
+    if (pending === undefined) return
+    clearTimeout(pending.timer)
+    this.wheelOpenAck = undefined
+    pending.reject(error)
+  }
+
+  /** Update the status and tell the overlay, which persists it for the panel. */
+  private setStatus(status: HelperStatus, detail?: string): void {
+    this.status = status
+    this.options.onStatus?.(status, detail)
+    const overlay = this.overlay
+    if (overlay === undefined || overlay.isDestroyed()) return
+    if (!this.overlayReady) {
+      // The overlay has not loaded yet; deliver once it can receive.
+      this.statusWhileLoading = status
+      return
+    }
+    this.postToOverlay(overlay, QUICK_HELP_IPC.helperStatus, status)
+  }
+
+  /** Deliver one input event, or hold it until the document can receive it. */
+  private emitInput(event: QuickHelpInputEvent): void {
+    const overlay = this.overlay
+    if (overlay === undefined || overlay.isDestroyed()) return
+    if (!this.overlayReady) {
+      // A burst while loading is kept, but bounded: a hotkey the user mashed
+      // during a slow first load must not replay as several wheel openings.
+      if (this.pending.length < 8) this.pending.push(event)
+      return
+    }
+    this.postToOverlay(overlay, QUICK_HELP_IPC.inputEvent, event)
+  }
+
+  /** Write one JSON line to the input helper. */
+  private writeHelper(payload: unknown): void {
+    try {
+      this.helper?.stdin?.write(`${JSON.stringify(payload)}\n`)
+    } catch (error) {
+      this.options.onStatus?.('crashed', error instanceof Error ? error.message : String(error))
+    }
+  }
+
+  /** Post one IPC message to a window, tolerating a window that just closed. */
+  private postToOverlay(window: BrowserWindow | undefined, channel: string, payload: unknown): void {
+    if (window === undefined || window.isDestroyed()) return
+    try {
+      window.webContents.send(channel, payload)
+    } catch {
+      // The window closed between the check and the send; nothing to recover.
+    }
+  }
+}
+
+/**
+ * Absolute path of the compiled input helper.
+ *
+ * Two layouts, and picking the wrong one produces a helper that cannot start:
+ * packaged builds carry it as an extra resource, while a dev run has it beside
+ * the sources. The existence check is the honest way to tell them apart — there
+ * is no build-time flag here that could drift from what the packager actually
+ * did.
+ *
+ * @param appRoot - `app.getAppPath()`.
+ * @returns The packaged path, or the development path when that is the one present.
+ */
+export function quickHelpHelperPath(appRoot: string, packaged: boolean): string {
+  if (!packaged) return join(process.env.DSH_QUICK_HELP_ROOT ?? join(appRoot, '..', '..', '..', 'lolping4dsh'), 'build', 'input-helper')
+  return join(process.resourcesPath, 'quick-help', 'input-helper')
+}
