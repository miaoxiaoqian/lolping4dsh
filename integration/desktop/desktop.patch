--- /dev/null
+++ b/apps/desktop/src/quick-help-ipc.ts
@@ -0,0 +1,226 @@
+/**
+ * Wire contract between the quick-help overlay and the Electron main process.
+ *
+ * Kept in its own file so the overlay's preload, the main-process window, and the
+ * plugin's copy of the shapes cannot drift apart. Nothing here carries behaviour:
+ * these are the names and the payload shapes only.
+ *
+ * The overlay's documents are served by the plugin over the Host's own HTTP
+ * surface, not from the application bundle. That is what gives the ask window its
+ * streaming answers without this layer proxying a byte range, and it keeps the
+ * feature's whole user interface inside the plugin that owns it.
+ */
+
+/** Pages the overlay window is allowed to show. */
+export type QuickHelpRoute = 'wheel' | 'ask' | 'settings'
+
+/** One short-lived, click-through visual and sound response to an accepted action. */
+export interface QuickHelpFeedbackRequest {
+  /** One selection identity, shared by immediate feedback and later chat navigation. */
+  readonly id?: string
+  readonly sessionId?: string
+  readonly kind: 'ping' | 'emote'
+  readonly image: string
+  readonly animation?: string
+  readonly sound?: string
+  readonly volume: number
+  readonly x: number
+  readonly y: number
+}
+
+/** How the overlay window should behave for one request. */
+export interface QuickHelpWindowRequest {
+  readonly route: QuickHelpRoute
+  /** Keep action media alive while this window navigates to the chat page. */
+  readonly feedback?: QuickHelpFeedbackRequest
+  /** Window placement in DIP. Omitted means "leave it where it is". */
+  readonly bounds?: { readonly x: number; readonly y: number; readonly width: number; readonly height: number }
+  /**
+   * Whether the window takes keyboard focus.
+   *
+   * The wheel must not: the user is typing in another application and a focus
+   * steal would put their keystrokes somewhere they did not choose. The ask
+   * window must, because it is a text field the user is typing into.
+   */
+  readonly focusable?: boolean
+  /** Whether clicks pass straight through to the application underneath. */
+  readonly clickThrough?: boolean
+  /**
+   * Opaque state the overlay reads once on load.
+   *
+   * This is deliberately not the per-gesture state. Coordinates arrive over
+   * {@link QUICK_HELP_IPC.inputEvent} as the helper reports them, because a
+   * window reload on every wheel opening would be visible as a flicker exactly
+   * when the user is trying to hit a target.
+   */
+  readonly state?: string
+}
+
+/** What the overlay is told about this machine. */
+export interface QuickHelpEnvironment {
+  /** Display work areas and scale factors, for placement and hit-testing. */
+  readonly displays: readonly { readonly id: number; readonly x: number; readonly y: number; readonly width: number; readonly height: number; readonly scale: number }[]
+  /** Current pointer position in screen DIP, for placing the ask window. */
+  readonly cursor: { readonly x: number; readonly y: number }
+  /** Whether the OS has granted the accessibility permission the helper needs. */
+  readonly accessibility: boolean
+  /** Whether a system-wide wheel can run here at all. */
+  readonly supported: boolean
+  /** The helper's current state. */
+  readonly helper: 'stopped' | 'starting' | 'running' | 'no-access' | 'crashed' | 'unsupported'
+}
+
+/**
+ * One input-helper event, forwarded to the overlay as it happens.
+ *
+ * There is no `hotkey` member: nothing in the main process watches for a
+ * combination any more, so an event type for it would be a channel with no sender.
+ */
+export interface QuickHelpInputEvent {
+  /** Product test opens an interactive mouse wheel without holding a key. */
+  readonly manual?: boolean
+  readonly type: 'wheelOpen' | 'wheelMove' | 'wheelRelease' | 'cancel' | 'error'
+  readonly x?: number
+  readonly y?: number
+  readonly code?: string
+  readonly message?: string
+}
+
+/** Result of probing a hotkey. */
+export interface QuickHelpBindResult {
+  readonly ok: boolean
+  /**
+   * Whether no other application already owns the combination.
+   *
+   * Separate from `ok` on purpose: the probe can succeed at answering while the
+   * answer is "someone else has it", and the caller shows those two cases very
+   * differently.
+   */
+  readonly available: boolean
+  /** The answer, phrased for the person who set it. */
+  readonly reason?: string
+}
+
+/**
+ * The bridge the overlay page is given.
+ *
+ * Every call moves a window, reports input, or changes one setting. There is no
+ * member that can read a file, run a command, or reach an arbitrary Host route:
+ * the page talks to its own plugin over HTTP for everything else, and this
+ * bridge is only the part of the product no plugin can provide.
+ */
+export interface QuickHelpBridge {
+  /** Exact formal Session owned by this compact application document. */
+  compactSessionId(): string | undefined
+  environment(): Promise<QuickHelpEnvironment>
+  show(request: QuickHelpWindowRequest): Promise<void>
+  feedback(request: QuickHelpFeedbackRequest): Promise<void>
+  /** Start the lifetime only after the visible feedback page has decoded its artwork. */
+  feedbackReady(generation: number): Promise<void>
+  onFeedbackShown(listener: (generation: number) => void): () => void
+  /** Run macOS's interactive region picker; cancelled selections never leave main-process memory. */
+  captureSelection(owner: string): Promise<'captured' | 'cancelled'>
+  /** Read the selected PNG for a local preview; it is uploaded only on Send. */
+  readCapture(owner: string): Promise<string | undefined>
+  /** Retain a user-selected PNG locally across page changes; no model upload occurs. */
+  stageCapture(owner: string, dataUrl: string): Promise<void>
+  /** Discard an unsent selection. */
+  discardCapture(): Promise<void>
+  /** Move only this chat window using the real cursor displacement. */
+  dragWindow(phase: 'start' | 'move' | 'end'): Promise<void>
+  hide(route?: QuickHelpRoute): Promise<void>
+  /** Bring the main application window forward, for "go to the main window". */
+  focusMain(): Promise<void>
+  /**
+   * Ask whether a chord is already taken by another application.
+   *
+   * Deliberately not "register": a held global shortcut is removed from every
+   * other application, which is the opposite of what this feature wants. The chord
+   * is claimed and released inside this call, and the wheel itself is driven by the
+   * input helper, which observes rather than owns.
+   *
+   * The result is the only honest signal: Electron returns false rather than
+   * throwing when another application already owns the combination.
+   */
+  probeHotkey(accelerator: string): Promise<QuickHelpBindResult>
+  /** Send configuration to the input helper. */
+  configure(config: QuickHelpHelperConfig): Promise<void>
+  /** Stop capturing input without tearing anything down. */
+  suspend(): Promise<void>
+  /** Signal that the wheel page has installed its input listener. */
+  rendererReady(): Promise<void>
+  onInput(listener: (event: QuickHelpInputEvent) => void): () => void
+  onHelperStatus(listener: (status: QuickHelpEnvironment['helper']) => void): () => void
+}
+
+/**
+ * Configuration pushed to the native input helper.
+ *
+ * The two flags are `0 | 1` rather than `boolean`, because the helper reads this
+ * message with a positional `sscanf` and `%d` — a JSON boolean renders as `true`
+ * or `false`, and `%d` stops at the `t`. Every field after the first boolean was
+ * therefore silently left at its default, which is how hold-to-open mode never
+ * worked. Keeping the wire type numeric is what makes the format string honest.
+ */
+export interface QuickHelpHelperConfig {
+  /** macOS virtual key code that opens the wheel. */
+  readonly triggerVk: number
+  /**
+   * `CGEventFlags` bits that must all be down for the keystroke to count.
+   *
+   * Zero means a bare key. Without this the helper could only compare key codes,
+   * and binding Control+Option+Space would swallow every Space in every
+   * application, because the key code alone cannot tell them apart.
+   */
+  readonly modifierMask: number
+  /** Press-and-hold mode; 0 is press-to-open, 1 is hold. */
+  readonly holdMode: 0 | 1
+  /** Points of movement needed to confirm a gesture in hold mode. */
+  readonly dragThreshold: number
+  /** Milliseconds of no input before an open wheel cancels itself. */
+  readonly watchdogMs: number
+  /** Capture is live; 0 parks the tap without removing it. */
+  readonly enabled: 0 | 1
+}
+
+/** IPC channel names, private to this feature. */
+export const QUICK_HELP_IPC = {
+  environment: 'dsh-quick-help:environment',
+  show: 'dsh-quick-help:show',
+  feedback: 'dsh-quick-help:feedback',
+  feedbackReady: 'dsh-quick-help:feedback-ready',
+  feedbackShown: 'dsh-quick-help:feedback-shown',
+  captureSelection: 'dsh-quick-help:capture-selection',
+  readCapture: 'dsh-quick-help:read-capture',
+  stageCapture: 'dsh-quick-help:stage-capture',
+  discardCapture: 'dsh-quick-help:discard-capture',
+  dragWindow: 'dsh-quick-help:drag-window',
+  hide: 'dsh-quick-help:hide',
+  focusMain: 'dsh-quick-help:focus-main',
+  probeHotkey: 'dsh-quick-help:probe-hotkey',
+  configure: 'dsh-quick-help:configure',
+  suspend: 'dsh-quick-help:suspend',
+  rendererReady: 'dsh-quick-help:renderer-ready',
+  productOpenWheel: 'dsh-quick-help:product-open-wheel',
+  productOpenAsk: 'dsh-quick-help:product-open-ask',
+  productRetry: 'dsh-quick-help:product-retry',
+  /** Main process to overlay, for input events that arrive with no renderer waiting. */
+  inputEvent: 'dsh-quick-help:input-event',
+  helperStatus: 'dsh-quick-help:helper-status',
+} as const
+
+/**
+ * Where the plugin serves each overlay page.
+ *
+ * `dsh-app://app` is the hostname `main.ts` forwards to the Host with its
+ * authentication cookie, so a page loaded from here can call its own plugin's
+ * routes with no credential of its own.
+ */
+export const QUICK_HELP_ORIGIN = 'dsh-app://app'
+
+/** Host path of each overlay route. */
+export const QUICK_HELP_ROUTE_PATH: Record<QuickHelpRoute, string> = {
+  wheel: '/quick-help/wheel',
+  ask: '/quick-help/ask',
+  settings: '/quick-help/settings',
+}
