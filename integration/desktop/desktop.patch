+  }
+
+  /** Whether a URL is one of this feature's own plugin pages. */
+  private isOwnPage(url: string): boolean {
+    if (!url.startsWith(`${QUICK_HELP_ORIGIN}/`)) return false
+    const [path] = url.slice(QUICK_HELP_ORIGIN.length).split('?')
+    if (path !== undefined && Object.values(QUICK_HELP_ROUTE_PATH).includes(path)) return true
+    const parsed = new URL(url)
+    return this.compactSessionId !== undefined && parsed.pathname === '/' && parsed.searchParams.get('dshQuickHelpSession') === this.compactSessionId
+  }
+
+  /** Authentication and native actions accept only this exact compact top frame. */
+  ownsCompactSender(event: Pick<IpcMainInvokeEvent, 'sender' | 'senderFrame'>): boolean {
+    return this.ownsCompactWebContents(event.sender.id) && event.senderFrame === this.overlay?.webContents.mainFrame
+  }
+
+  /** Identify the compact Client when authenticating its Host WebSocket. */
+  ownsCompactWebContents(id: number | undefined): boolean {
+    const window = this.overlay
+    return !!window && !window.isDestroyed() && window.webContents.id === id
+      && this.overlayRoute === QUICK_HELP_ROUTE_PATH.ask && !!this.compactSessionId
+      && this.isOwnPage(window.webContents.getURL()) && new URL(window.webContents.getURL()).pathname === '/'
+  }
+
+  /**
+   * Reject any sender that is not this feature's own overlay.
+   *
+   * Comparing the webContents rather than the URL is deliberate: the main window
+   * serves the same origin, and it has no business registering global shortcuts
+   * or reading the helper's state on this feature's behalf.
