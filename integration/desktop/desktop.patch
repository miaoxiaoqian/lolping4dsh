+  /** Shut the helper down, making sure the event tap really goes away. */
+  private stop(): void {
+    const child = this.helper
+    this.helper = undefined
+    if (child === undefined) return
+    try {
+      child.stdin?.write('{"type":"shutdown"}\n')
+      child.stdin?.end()
+    } catch {
+      // The pipe may already be gone; the kill below is the guarantee.
+    }
+    // SIGTERM lets the helper remove its tap cleanly. If it does not go, it is
+    // killed: a surviving tap would keep swallowing input with no reader.
+    const escalate = setTimeout(() => {
+      try { child.kill('SIGKILL') } catch { /* already gone */ }
+    }, 1500)
+    child.once('exit', () => clearTimeout(escalate))
+  }
+
+  /** Read whole lines out of the helper's stdout. */
+  private consume(chunk: string): void {
+    this.helperBuffer.text += chunk
+    let index = this.helperBuffer.text.indexOf('\n')
+    while (index !== -1) {
+      const line = this.helperBuffer.text.slice(0, index)
+      this.helperBuffer.text = this.helperBuffer.text.slice(index + 1)
+      this.handleLine(line)
+      index = this.helperBuffer.text.indexOf('\n')
+    }
+    // A helper that dies mid-line leaves a tail; drop it rather than letting it
+    // prefix the next helper's first message.
+    if (this.helperBuffer.text.length > 4096) this.helperBuffer.text = ''
+  }
+
+  /** Interpret one helper message. Unrecognised lines are ignored. */
+  private handleLine(line: string): void {
+    const trimmed = line.trim()
+    if (!trimmed.startsWith('{')) return
+    let value: Record<string, unknown>
+    try {
+      value = JSON.parse(trimmed) as Record<string, unknown>
+    } catch {
+      return
+    }
+    const type = value.type
+    if (type === 'ready') {
+      if (this.helperReadyTimer !== undefined) clearTimeout(this.helperReadyTimer)
+      this.restarts = 0
+      if (this.lastHelperConfig !== undefined) this.writeHelper({ type: 'config', ...this.lastHelperConfig })
+      this.setStatus('running')
+      return
+    }
+    if (type === 'bye') {
+      this.setStatus('stopped')
+      return
+    }
+    if (type === 'error') {
+      if (this.helperReadyTimer !== undefined) clearTimeout(this.helperReadyTimer)
+      const code = typeof value.code === 'string' ? value.code : 'error'
+      const message = typeof value.message === 'string' ? value.message : ''
+      this.setStatus(code === 'no_access' ? 'no-access' : 'crashed', message)
+      this.emitInput({ type: 'error', code, message })
+      return
+    }
+    if (type === 'wheelOpen' || type === 'wheelMove' || type === 'wheelRelease' || type === 'cancel') {
+      const input: QuickHelpInputEvent = {
+        type,
+        ...typeof value.x === 'number' ? { x: value.x } : {},
+        ...typeof value.y === 'number' ? { y: value.y } : {},
+      }
