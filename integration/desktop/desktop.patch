new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/quick-help-position.ts
@@ -0,0 +1,63 @@
+/** Device-local position of the draggable quick-help chat window. */
+import { mkdirSync, readFileSync, renameSync, unlinkSync, writeFileSync } from 'node:fs'
+import { randomUUID } from 'node:crypto'
+import { dirname } from 'node:path'
+
+export interface AskPosition { readonly x: number; readonly y: number }
+export interface WorkArea extends AskPosition { readonly width: number; readonly height: number }
+
+/** Ignore malformed or partial state and use the pointer placement instead. */
+export function readAskPosition(path: string): AskPosition | undefined {
+  try {
+    const value: unknown = JSON.parse(readFileSync(path, 'utf8'))
+    if (typeof value !== 'object' || value === null || !('x' in value) || !('y' in value)) return undefined
+    const { x, y } = value
+    if (!Number.isSafeInteger(x) || !Number.isSafeInteger(y)) return undefined
+    return { x: x as number, y: y as number }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined
+    return undefined
+  }
+}
+
+/** Atomically replace only coordinates, with no chat or session data. */
+export function writeAskPosition(path: string, position: AskPosition): void {
+  const directory = dirname(path)
+  mkdirSync(directory, { recursive: true, mode: 0o700 })
+  const temporary = `${path}.${randomUUID()}.tmp`
+  try {
+    writeFileSync(temporary, `${JSON.stringify(position)}\n`, { flag: 'wx', mode: 0o600 })
+    renameSync(temporary, path)
+  } catch (error) {
+    try { unlinkSync(temporary) } catch { /* The temporary file was never created or is already gone. */ }
+    throw error
+  }
+}
+
+/** Keep the whole chat visible after display removal or resolution changes. */
+export function clampAskBounds(position: AskPosition, area: WorkArea, width: number, height: number): WorkArea {
+  const fittedWidth = Math.min(width, area.width)
+  const fittedHeight = Math.min(height, area.height)
+  return {
+    x: Math.round(Math.max(area.x, Math.min(position.x, area.x + area.width - fittedWidth))),
+    y: Math.round(Math.max(area.y, Math.min(position.y, area.y + area.height - fittedHeight))),
+    width: fittedWidth,
+    height: fittedHeight,
+  }
+}
+
+/** Place feedback at the selection point, clamping only at the display edge. */
+export function feedbackBounds(point: AskPosition, area: WorkArea): WorkArea {
+  return clampAskBounds({ x: point.x - 80, y: point.y - 80 }, area, 160, 160)
+}
+
+/** Keep the chat beside the selected effect, with a gap from its visible artwork. */
+export function askBesideFeedback(point: AskPosition & { readonly kind: 'ping' | 'emote' }, area: WorkArea): WorkArea {
+  const effect = feedbackBounds(point, area)
+  const center = { x: effect.x + effect.width / 2, y: effect.y + effect.height / 2 }
+  const distance = (point.kind === 'emote' ? 65 : 52) + 12
+  const right = center.x + distance
+  const left = center.x - distance - 360
+  const x = right + 360 <= area.x + area.width ? right : left
+  return clampAskBounds({ x, y: center.y - 36 }, area, 360, 400)
+}
diff --git a/apps/desktop/src/quick-help-wiring.ts b/apps/desktop/src/quick-help-wiring.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/quick-help-wiring.ts
@@ -0,0 +1,152 @@
+/**
+ * Wires the quick-help feature into the desktop lifecycle.
+ *
+ * Three things happen here and nowhere else: the input helper's path is
+ * resolved, the IPC surface is installed, and the resources are released on quit.
+ *
+ * The feature is created eagerly at startup rather than on demand. The overlay
+ * window and the helper both have to exist before the first hotkey press, and a
+ * window created inside the keypress handler would show an empty rectangle while
+ * its document loaded — long enough to be noticed.
+ *
+ * Nothing here knows what a wheel slot does. The plugin owns that entirely and
+ * reaches this layer only through the narrow preload bridge.
+ */
+
+import { app } from 'electron'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { QuickHelpDesktop, quickHelpHelperPath } from './quick-help.ts'
+
+/** Where the packager places the helper inside a built application. */
+const PACKAGED_HELPER = join('quick-help', 'input-helper')
+
+/**
+ * Find the input helper.
+ *
+ * Three layouts are tried in order, and each miss is reported rather than guessed
+ * past: a helper that silently resolves to nothing shows up as a wheel which
+ * never opens, with nothing in the log to explain it.
+ *
+ * @returns The helper's path, and where it was found.
+ */
+export function resolveQuickHelpHelper(appPath: string, resourcesPath: string, packaged: boolean): { path: string; source: string } | { missing: string[] } {
+  const candidates: { path: string; source: string }[] = [
+    { path: join(resourcesPath, PACKAGED_HELPER), source: '打包产物 resources/' },
+    { path: quickHelpHelperPath(appPath, false), source: '开发态 ../../dsh-quick-help/build/' },
+    { path: quickHelpHelperPath(appPath, true), source: 'resources/quick-help/' },
+  ]
+  const missing: string[] = []
+  for (const candidate of candidates) {
+    if (existsSync(candidate.path)) {
+      // A packaged build must not silently load a development binary from a
+      // sibling directory: that would run unsigned native code in a shipped app.
+      if (packaged && !candidate.source.startsWith('打包产物')) continue
+      return candidate
+    }
+    missing.push(`${candidate.source}（${candidate.path}）`)
+  }
+  return { missing }
+}
+
+/** Construction parameters. */
+export interface QuickHelpWiringOptions {
+  /** Brings the main window forward, for "go to the main window". */
+  readonly focusMainWindow: () => void
+  /** Reports a status change so the panel can show it. */
+  readonly onStatus?: (status: string, detail?: string) => void
+  /**
+   * Directory the preload bundle was built into.
+   *
+   * Passed in rather than derived here because the desktop build owns its own
+   * output layout: this module must not have to know whether the bundle sits in
+   * `dist/`, `out/main/`, or somewhere a bundler chose.
+   */
+  readonly preloadDir: string
+  /**
+   * The Host's URL and cookie once the backend is ready, or undefined before that.
+   *
+   * Read per attempt by {@link QuickHelpDesktop}, because the feature is installed
+   * at startup and the Host finishes booting afterwards.
+   */
+  readonly hostEndpoint?: () => { readonly host: string; readonly cookie: string } | undefined
+}
+
+/** What the wiring produced. */
+export interface QuickHelpWiring {
+  readonly desktop: QuickHelpDesktop
+  openWheel(): Promise<void>
+  openAsk(): void
+  retry(): void
+  /** Release every global resource. Safe to call twice. */
+  dispose(): void
+}
+
+/**
+ * Locate the overlay preload.
+ *
+ * Probed rather than computed, because the desktop build emits preloads as `.cjs`
+ * next to the main bundle — a path built by hand with a `.js` extension resolves to
+ * nothing, and the result is a window with no bridge and no error: every gesture
+ * would arrive at a page that cannot hear it, which looks exactly like a dead
+ * hotkey.
+ */
+export function resolveQuickHelpPreload(preloadDir: string): string {
+  const candidates = [
+    join(preloadDir, 'preload-quick-help.cjs'),
+    join(preloadDir, 'main', 'preload-quick-help.cjs'),
+    // The unbundled path, which is what a dev run loads directly.
+    join(preloadDir, 'types', 'preload-quick-help.js'),
+  ]
+  for (const candidate of candidates) {
+    if (existsSync(candidate)) return candidate
+  }
+  // Reported even when absent so the failure names a real file rather than an
+  // empty string; Electron will report the load error for it.
+  return candidates[0] ?? join(preloadDir, 'preload-quick-help.cjs')
+}
+
+/**
+ * Create and install the feature.
+ *
+ * A missing helper is not fatal: the application starts, the panel explains what
+ * is absent, and the rest of DSH is unaffected. Refusing to boot over an optional
+ * feature would be a far worse failure than a wheel that does not open.
+ *
+ * @returns The wiring, or the reason the feature is unavailable.
+ */
+export function installQuickHelp(options: QuickHelpWiringOptions): QuickHelpWiring {
+  const appPath = app.getAppPath()
+  const packaged = app.isPackaged
+  const found = resolveQuickHelpHelper(appPath, process.resourcesPath, packaged)
+  const report = (status: string, detail?: string): void => { options.onStatus?.(status, detail) }
+  const preloadPath = resolveQuickHelpPreload(options.preloadDir)
+  const base = {
+    preloadPath,
+    compactChat: true,
+    askPositionPath: join(app.getPath('userData'), 'quick-help', 'window-position.json'),
+    focusMainWindow: options.focusMainWindow,
+    ...(options.onStatus === undefined ? {} : { onStatus: report }),
+    ...(options.hostEndpoint === undefined ? {} : { hostEndpoint: options.hostEndpoint }),
+  }
+
+  if ('missing' in found) {
+    report('crashed', `找不到输入助手，已尝试：${found.missing.join('；')}。轮盘不会响应。`)
+    // An empty path can never spawn, and `supported` is still true so the panel
+    // can explain the absence rather than claiming the platform is unsupported.
+    const desktop = new QuickHelpDesktop({ helperPath: '', ...base })
+    desktop.install()
+    return { desktop, openWheel: () => desktop.openWheel(), openAsk: () => desktop.openAsk(), retry: () => desktop.retry(), dispose: () => { desktop.dispose() } }
+  }
+
+  const desktop = new QuickHelpDesktop({ helperPath: found.path, ...base })
+  desktop.install()
+
+  return {
+    desktop,
+    openWheel: () => desktop.openWheel(),
+    openAsk: () => desktop.openAsk(),
+    retry: () => desktop.retry(),
+    dispose: () => { desktop.dispose() },
+  }
+}
