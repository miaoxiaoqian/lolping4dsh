+        this.loadWheelPage(input)
+        return
+      }
+      this.emitInput(input)
+    }
+  }
+
+  /** Load and show the persistent wheel page, optionally replaying its opening input. */
+  private loadWheelPage(opening?: QuickHelpInputEvent, autoHideMs?: number): void {
+    if (!this.supported || this.disposed) return
+    const path = QUICK_HELP_ROUTE_PATH.wheel
+    const window = this.ensureOverlay()
+    // Never expose the overlay's default Electron bounds while the wheel page is
+    // loading or calculating its position. A stalled renderer would otherwise
+    // leave a transparent, always-on-top 800×600 window intercepting clicks in
+    // other applications.
